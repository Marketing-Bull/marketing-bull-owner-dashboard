# Shared access token for the dashboard. A secret you invent, not one issued by
# any service -- generate with: openssl rand -base64 32
#
# Set:   every request (page and API) needs this token, entered once at /login.
# Unset: the dashboard is LOCKED -- pages show setup instructions, APIs answer
#        503, and nothing is served or written (see the opt-out below).
#
# The dashboard holds MRR, projections, goals, client phone numbers -- and,
# with the consolidation, client rates and financial entries. Locked is the
# default so an unconfigured deployment can never quietly serve them.
OWNER_DASHBOARD_AUTH_TOKEN=

# The deliberate way to run WITHOUT a token (laptop, local dev): set to 1 and
# the dashboard is open to anyone who can reach it, with an "Unprotected" chip
# in the header. Ignored whenever a token is set.
OWNER_DASHBOARD_ALLOW_UNPROTECTED=

# Where the SQLite database lives. Default: <cwd>/data/dashboard.sqlite.
# Daily backups are written to a backups/ directory next to this file.
OWNER_DASHBOARD_DB_PATH=

# Optional upstream proxies. When set, these take priority over the direct
# ClickUp / Google Calendar integrations.
OWNER_DASHBOARD_CALENDAR_URL=
OWNER_DASHBOARD_DATA_URL=

# Override the ClickUp API base. Used to point tests at a stand-in server so the
# write path can be exercised without touching a real account. Leave blank in
# normal use.
OWNER_DASHBOARD_CLICKUP_API_BASE=

# ClickUp integration (used when OWNER_DASHBOARD_DATA_URL is unset).
# The API key itself is read from ~/.openclaw/secrets.json -> env.CLICKUP_API_KEY
OWNER_DASHBOARD_CLICKUP_TEAM_ID=
OWNER_DASHBOARD_CLICKUP_ASSIGNEE_ID=

# Google Calendar account passed to the `gog` CLI (~/.local/bin/gog).
OWNER_DASHBOARD_CALENDAR_ACCOUNT=
