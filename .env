# Committed defaults — NON-SECRET values only. Anything secret (the auth
# token above all) goes in .env.local or the systemd unit, which override this
# file and stay out of git.
#
# The dashboard runs OPEN by choice right now: Alex opted for zero-ceremony
# deploys (pull, restart, done) over the login gate. The header shows the
# "Unprotected" chip while this is in effect.
#
# To lock the dashboard later, either is enough — a configured token always
# beats this opt-out:
#   - set OWNER_DASHBOARD_AUTH_TOKEN in .env.local / the systemd unit, or
#   - delete this line (and this file, if empty) to fall back to
#     locked-by-default.
OWNER_DASHBOARD_ALLOW_UNPROTECTED=1
